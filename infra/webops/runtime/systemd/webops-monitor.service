[Unit]
Description=Elevate360 bounded read-only diagnostic tick
After=docker.service
ConditionPathExists=/etc/elevate360-webops/schedule.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecCondition=/usr/bin/node /opt/elevate360-webops/current/infra/webops/runtime/boot-gate.mjs /etc/elevate360-webops/schedule.json /var/lib/elevate360-webops/boot/approval.json
ExecCondition=/usr/bin/node /opt/elevate360-webops/current/infra/webops/runtime/capacity-gate.mjs /etc/elevate360-webops/schedule.json
ExecStart=/usr/bin/node /opt/elevate360-webops/current/infra/webops/runtime/guarded-scheduled-runner-cli.mjs /etc/elevate360-webops/schedule.json /var/lib/elevate360-webops/boot/approval.json
# Four 10s inspections + 35s exec + 15s host/storage allowance.
TimeoutStartSec=90
TimeoutStopSec=5
KillMode=control-group
Restart=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/elevate360-webops/schedule /var/lib/elevate360-webops/runner /var/lib/elevate360-webops/reports
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
