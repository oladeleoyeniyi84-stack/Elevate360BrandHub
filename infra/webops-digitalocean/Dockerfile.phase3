# Build-only candidate. Never deploy automatically; base digest must be approved before staging.
FROM node:22-bookworm-slim AS webops-build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY server ./server
COPY script/build-webops-phase3.mjs ./script/build-webops-phase3.mjs
RUN node script/build-webops-phase3.mjs \
 && node --check dist/webops-phase3/webops-worker-check.mjs \
 && node --check dist/webops-phase3/webops-gateway-server.mjs

FROM node:22-bookworm-slim AS worker
WORKDIR /app
COPY --from=webops-build --chown=node:node /build/dist/webops-phase3/webops-worker-check.mjs /app/webops-worker-check.mjs
COPY --chmod=0555 infra/webops-digitalocean/worker-check.sh /app/webops-worker-check
USER node
# No daemon or scheduler. Explicit diagnostic invocation required.
CMD ["/bin/false"]

FROM node:22-bookworm-slim AS gateway
WORKDIR /app
COPY --from=webops-build --chown=node:node /build/dist/webops-phase3/webops-gateway-server.mjs /app/webops-gateway-server.mjs
COPY --chmod=0555 infra/webops-digitalocean/gateway-check.sh /app/webops-gateway-check
USER node
# The real listener is manual-only, requiring privately mounted token and audit paths.
CMD ["/bin/false"]
